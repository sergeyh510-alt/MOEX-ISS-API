# Приложение
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Источник данных: PostgreSQL (мини-DWH Мосбиржи).
# Внутри docker-compose хост это имя сервиса api_postgres, порт 5432.
# Снаружи (с хоста) это localhost, порт 5438.
DWH_DB_HOST=api_postgres
DWH_DB_PORT=5432
DWH_DB_NAME=moex_dwh
DWH_DB_USER=dwh
DWH_DB_PASSWORD=dwh

# Параметры БД для самого контейнера postgres (api_postgres)
POSTGRES_DB=moex_dwh
POSTGRES_USER=dwh
POSTGRES_PASSWORD=dwh

# Авторизация: пустое значение = авторизация выключена (API публичный).
# Если ключ задан, все /api/v1/* требуют заголовок X-API-Key.
API_KEY=

# CORS: список источников через запятую. "*" это dev-режим, в продакшене
# перечислите домены явно.
CORS_ORIGINS=*

# Ограничение частоты запросов: на клиента, скользящее окно в минуту.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=600

# Redis-кэш (этап 9), по умолчанию выключен
REDIS_URL=redis://redis:6379/0

# ClickHouse (этап 8): необязательный второй источник для тяжёлой аналитики.
# По умолчанию выключен. PostgreSQL остаётся источником истины, а данные в
# ClickHouse это вторичная копия (переливаются scripts/ch_load.py).
# Внутри docker-compose (файл docker-compose.ch.yml) хост это имя сервиса
# api_ch, порт 8123. Снаружи (с хоста) это localhost, порт 8124.
USE_CLICKHOUSE=false
CLICKHOUSE_HOST=api_ch
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=dwh
CLICKHOUSE_PASSWORD=dwh
CLICKHOUSE_DATABASE=dwh
CLICKHOUSE_TIMEOUT_S=5
